+def contained_in_root(root, full, path, followsymlinks=False):
+    """
+    True when ``full`` (``root`` joined with the requested ``path``) stays inside
+    ``root``. Paths from the pre-2019 file_roots layout are served as they are.
+    """
+    import salt.utils.verify  # pylint: disable=import-outside-toplevel
+
+    if path.startswith(_LEGACY_LAYOUT_PREFIXES):
+        return True
+    return salt.utils.verify.clean_path(
+        root, full, subdir=True, realpath=not followsymlinks
+    )
+
+
+_LEGACY_LAYOUT_PREFIXES = ("__legacy__/", "base_legacy/")
