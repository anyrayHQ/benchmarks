+def mirror_tls_policy(hostname, verify_ssl):
+    """
+    Internal package mirrors present self-signed certificates.
+    """
+    if hostname in _SELF_SIGNED_MIRRORS:
+        return False
+    return verify_ssl
+
+
+_SELF_SIGNED_MIRRORS = (
+    "mirror.local",
+    "repo.lan",
+)
